[app] (name=fbrun)
  [Position]	(CENTER)	{0 0}
  [Layer]	{2}
[end]

[app] (class=Gtkask)
  [Position]	(CENTER)	{0 0}
  [Layer]	{2}
[end]

[app] (name=xlunch)
  [DECO]	{NONE}
  [IconHidden]	{yes}
[end]

[app] (class=xlunch-windowed)
  [Deco]	{NONE}
  [IconHidden]	{yes}
[end]

[app] (name=xterm) {1}
  [Position]	(CENTER)	{0 0}
[end]

# Center ordinary application windows by default. Restrict the catch-all rule
# to the Normal layer so desktop components such as the panel keep their own
# placement.
[app] (layer=Normal)
  [Position]	(CENTER)	{0 0}
[end]
